# Modelo de configuração. Copie para `.env` e preencha.
#
#     cp .env.example .env
#
# O `.env` real NUNCA vai para o repositório (está no .gitignore): ele carrega
# credenciais de produção. Este arquivo é só a lista do que precisa existir.

# ---------------------------------------------------------------------------
# Obrigatórias para o app subir
# ---------------------------------------------------------------------------

# PostgreSQL (local, Neon, Supabase, RDS...). É a única configuração que fica
# só aqui: as demais integrações são editáveis em /admin, mas o banco não pode
# depender de um valor guardado dentro dele mesmo.
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Origem pública do app, sem barra no fim. É a base dos links enviados por
# e-mail (convite e redefinição de senha). Em produção precisa ser o domínio
# real, ou os links apontarão para a máquina de quem gerou o convite.
APP_BASE_URL=http://localhost:3000

# Chave mestra que cifra os segredos guardados em IntegrationSetting (Fernet).
# Gere uma com:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: trocar esta chave torna ilegíveis os segredos já gravados no banco
# (eles se comportam como "não configurado" e precisam ser digitados de novo
# em /admin). Precisa existir ANTES de rodar o seed, que já cifra as chaves
# de API abaixo.
SETTINGS_ENCRYPTION_KEY=

# OpenAI: usada pelos três agentes (classificação, resumo e consulta). O modelo
# e o esforço de cada um são escolhidos em /admin, não aqui: as variáveis abaixo
# são só a SEMENTE da primeira execução, e depois disso o banco manda.
OPENAI_API_KEY=
OPENAI_CLASSIFICACAO_MODEL=gpt-5.4-mini
OPENAI_RESUMO_MODEL=gpt-5.4-mini
OPENAI_INSIGHTS_MODEL=gpt-5.4-mini

# ---------------------------------------------------------------------------
# Primeiro super admin (só na primeira execução do seed)
# ---------------------------------------------------------------------------
# Ele é o único usuário criado fora do fluxo de convite, pois não haveria quem o
# convidasse. Todos os demais entram por /admin -> "Convidar usuário".
#
# SUPER_ADMIN_SENHA não tem valor padrão de propósito: sem ela o seed para e
# explica o que fazer. Só o hash bcrypt vai para o banco. Troque a senha no
# primeiro acesso (/profile) e remova a variável depois.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NOME=
SUPER_ADMIN_SENHA=


# ---------------------------------------------------------------------------
# Microsoft Graph
# ---------------------------------------------------------------------------
# Serve para duas coisas: enviar e-mail transacional (convite e redefinição de
# senha) e LER a caixa do comercial para classificar. São permissões diferentes.
#
# O registro no Entra ID precisa de DUAS permissões de APLICAÇÃO (não
# delegadas), ambas com consentimento de administrador:
#     Mail.Send       -> enviar convites
#     Mail.ReadWrite  -> ler, marcar e mover e-mails (Mail.Read não basta)
#
# GRAPH_SENDER_EMAIL precisa ser uma caixa REAL do locatário. Conta pessoal
# (hotmail.com, outlook.com, gmail.com) NUNCA funciona no fluxo de aplicação,
# mesmo com as credenciais certas: o Graph responde ErrorInvalidUser.
#
# GRAPH_TENANT_ID é o Directory ID do Entra, nada a ver com o tenant_id da
# aplicação.
#
# Segurança: Mail.ReadWrite de APLICAÇÃO dá acesso a todas as caixas do
# locatário. Restrinja o client ID à caixa comercial com uma
# ApplicationAccessPolicy do Exchange Online (ver MANUAL.md, seção 1.1).
GRAPH_SENDER_EMAIL=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=


# ---------------------------------------------------------------------------
# Caixa de TESTE (opcional, só para os testes funcionais)
# ---------------------------------------------------------------------------
# Usada apenas por `pytest -m graph_funcional`, que fica DESLIGADO por padrão.
#
# TESTER_GRAPH_SENDER_EMAIL precisa apontar para uma caixa DIFERENTE de
# GRAPH_SENDER_EMAIL: a suíte se recusa a rodar se as duas forem iguais, para
# que nenhum teste toque a caixa de produção nem por configuração errada.
#
# Ela também precisa ser uma caixa corporativa de um locatário, pelo mesmo
# motivo do bloco acima: uma conta pessoal não é acessível pelo fluxo de
# aplicação e os testes funcionais falharão com ErrorInvalidUser.
TESTER_GRAPH_SENDER_EMAIL=
TESTER_GRAPH_TENANT_ID=
TESTER_GRAPH_CLIENT_ID=
TESTER_GRAPH_CLIENT_SECRET=
